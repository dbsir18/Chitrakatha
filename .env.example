# PostgreSQL connection string.
# For local dev: get a free DB at neon.tech
# On Vercel: automatically set when you add Vercel Postgres to your project
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# OPTIONAL — only needed if LLM_MODEL is set to "gpt-4o" (OpenAI directly).
# With LLM_MODEL=deepseek/deepseek-v4-flash (default), this is not needed.
# Embeddings also fall back to OpenRouter automatically if this is absent.
OPENAI_API_KEY=""

# LLM model for scene design. Default: deepseek/deepseek-v4-flash (via OpenRouter).
# Override only if needed: gpt-4o (requires OPENAI_API_KEY) | google/gemini-3.7-flash
LLM_MODEL="deepseek/deepseek-v4-flash"

# Required for: image generation (Qwen Image 3 Pro) + any OpenRouter LLM_MODEL
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""

# Required for image storage (Vercel Blob).
# On Vercel: automatically set when you add Blob storage to your project.
# For local dev: get a token from vercel.com/dashboard -> Storage -> Blob -> Connect
BLOB_READ_WRITE_TOKEN=""

# OPTIONAL — durable generation executor (Inngest). When unset, generation
# runs via after() inside the request, which works but is capped by the
# serverless function-duration limit (300s on Vercel Hobby).
#
# Production (Inngest Cloud): create an app at inngest.com, point it at
# https://<your-domain>/api/inngest, and set both keys from its "Keys" page.
# Local dev: leave INNGEST_EVENT_KEY unset, run `npx inngest-cli dev
# -u http://localhost:3000/api/inngest`, and set INNGEST_DEV=1 — the SDK then
# sends events to the local dev server on :8288.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV=""
