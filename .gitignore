# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example template committed, ignore actual secrets
.env
.env.local
.env*.local
.env.development
.env.production

# IDE / agent internals (Cursor, Claude, Windsurf)
.agents/
.claude/
.windsurf/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# database
*.db
*.db-journal
*.db-*

# generated prisma client (regenerated by `prisma generate` at build time)
lib/generated/

# AI-generated images (stored in Vercel Blob in production)
public/generated/

# test/report outputs
reports/**/*.png
reports/**/*.jpg
next-env.d.ts

/lib/generated/prisma
